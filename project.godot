; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FNG"
config/description="We fish"
config/version="0.0"
run/main_scene="res://Scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false
boot_splash/fullsize=false
config/icon="res://Assets/GameIcons/icon.png"
config/windows_native_icon="res://Assets/GameIcons/icon.ico"

[autoload]

Globals="*res://Globals.gd"
ConfigManager="*res://configManager.gd"
ShinyHandler="*res://shinyHandler.gd"
LimboConsole="*res://addons/limbo_console/limbo_console.gd"

[display]

window/size/mode=2
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[editor_plugins]

enabled=PackedStringArray("res://addons/limbo_console/plugin.cfg")

[gui]

theme/custom="res://defaultTheme.tres"
theme/custom_font="res://Assets/Fonts/PublicPixel-rv0pA.ttf"

